APP_ENV=development
DATABASE_URL=postgresql+psycopg://vortex:vortex@postgres:5432/vortex
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-64-random-characters
JWT_ISSUER=vortex
ACCESS_TOKEN_MINUTES=1440

S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=vortex-media
S3_ACCESS_KEY_ID=vortex
S3_SECRET_ACCESS_KEY=vortex-password
S3_REGION=us-east-1
S3_SERVER_SIDE_ENCRYPTION=

OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-5.4-mini
OPENAI_CONTESTED_MODEL=gpt-5.5
SEARCH_API_KEY=
SEARCH_ENDPOINT=
TRANSCRIPTION_PROVIDER=openai

VISUAL_FACE_MODEL_PATH=shunda012/vit-deepfake-detector
VISUAL_GENERAL_MODEL_PATH=capcheck/ai-human-generated-image-detection
VISUAL_MODEL_LICENSE=production-approved
AUDIO_MODEL_ID=Gustking/wav2vec2-large-xlsr-deepfake-audio-classification
AUDIO_MODEL_LICENSE=production-approved
ALLOW_REMOTE_MODEL_DOWNLOADS=false

FREE_MONTHLY_ANALYSES=5
FREE_MAX_FILE_MB=150
FREE_MAX_DURATION_SECONDS=180
PAID_MAX_FILE_MB=2048
PAID_MAX_DURATION_SECONDS=3600

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
CORS_ORIGINS=https://your-vortex-web.example.com
ORCHESTRATOR_QUEUE_NAME=orchestration
